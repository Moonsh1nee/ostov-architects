{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home page",
    "description": "Hero (one title line per text line), manifesto, numbers and the featured projects strip."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroTitle": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "component",
      "repeatable": false,
      "component": "shared.figure",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "manifesto": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "featuredProjects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    }
  }
}
